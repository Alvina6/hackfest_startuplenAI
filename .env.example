# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional Gemini model override (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# MONGODB_URI: MongoDB Atlas connection string (optional in local dev; uses .data/ file fallback if omitted).
MONGODB_URI=""

# JWT_SECRET: Long random secret used to sign authentication tokens.
JWT_SECRET="replace_with_a_long_random_secret_at_least_32_chars"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000 in AI Studio runtime).
PORT="3000"

# CORS_ORIGIN: Optional comma-separated allowlist for production CORS.
CORS_ORIGIN=""
